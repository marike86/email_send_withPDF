<Window x:Class="PdfMailer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PdfMailer.App" xmlns:core="using:PdfMailer.Core">
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources><local:HasTextConverter x:Key="HasText" /><local:VisibleConverter x:Key="Visible" /></Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Padding="20,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE715;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="PDF 邮件工作台" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" IsPaneOpen="True" OpenPaneLength="190"
            IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="NavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="发送工作台" Tag="workspace" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE715;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid Padding="28,10,28,24" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid x:Name="Workspace">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6" Margin="0,0,0,20">
                        <TextBlock Text="发送工作台" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="WorkspaceSubtitle" Text="将每一份 PDF，送到对应的人手中。先检查，再确认发送。" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <ContentControl Grid.Row="1" IsEnabled="{Binding CanEdit}" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="准备文件" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="PdfFolderInput" Header="PDF 目录" PlaceholderText="选择附件文件夹" Padding="12,8,48,8"
                                        TextChanged="SettingsTextChanged" ToolTipService.ToolTip="{Binding Text, ElementName=PdfFolderInput}" />
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Padding="8" BorderThickness="0" Background="Transparent"
                                        Click="PickFolder" AutomationProperties.Name="浏览 PDF 附件目录" ToolTipService.ToolTip="选择文件夹"><FontIcon Glyph="&#xE8B7;" FontSize="16" /></Button>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="ExcelInput" Header="学生表格" PlaceholderText="选择 Excel 文件" Padding="12,8,48,8"
                                        TextChanged="SettingsTextChanged" ToolTipService.ToolTip="{Binding Text, ElementName=ExcelInput}" />
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Padding="8" BorderThickness="0" Background="Transparent"
                                        Click="PickExcel" AutomationProperties.Name="浏览学生 Excel 表格" ToolTipService.ToolTip="选择 Excel"><FontIcon Glyph="&#xE8A5;" FontSize="16" /></Button>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <TextBox x:Name="TemplateInput" Header="邮件模板" PlaceholderText="选择 UTF-8 模板" Padding="12,8,48,8"
                                        TextChanged="SettingsTextChanged" ToolTipService.ToolTip="{Binding Text, ElementName=TemplateInput}" />
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Padding="8" BorderThickness="0" Background="Transparent"
                                        Click="PickTemplate" AutomationProperties.Name="浏览邮件模板" ToolTipService.ToolTip="选择模板"><FontIcon Glyph="&#xE8A5;" FontSize="16" /></Button>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border></ContentControl>
                    <Grid x:Name="MetricsPanel" Grid.Row="2" ColumnSpacing="12" Margin="0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="18,12"><StackPanel Spacing="3"><TextBlock Text="{Binding TotalCount}" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="附件总数" Style="{StaticResource MutedTextStyle}" /></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18,12"><StackPanel Spacing="3"><TextBlock Text="{Binding PendingCount}" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><TextBlock Text="待发送（含失败）" Style="{StaticResource MutedTextStyle}" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18,12"><StackPanel Spacing="3"><TextBlock Text="{Binding SuccessCount}" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="已发送" Style="{StaticResource MutedTextStyle}" /></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="18,12"><StackPanel Spacing="3"><TextBlock Text="{Binding AttentionCount}" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="需关注" Style="{StaticResource MutedTextStyle}" /></StackPanel></Border>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,0,0,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                        <TextBlock Text="检查与预览" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchInput" Grid.Column="1" PlaceholderText="搜索姓名、学号或文件…" TextChanged="FilterChanged" />
                        <ComboBox x:Name="StateFilter" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="筛选发送状态">
                            <ComboBoxItem Content="全部状态" /><ComboBoxItem Content="待发送" /><ComboBoxItem Content="已发送" /><ComboBoxItem Content="需关注" />
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="4" ColumnSpacing="16" MinHeight="160">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" MinWidth="380" /><ColumnDefinition Width="*" MinWidth="320" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Padding="20,12" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="0.6*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="PDF 文件" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Grid.Column="1" Text="姓名" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Grid.Column="2" Text="收件邮箱" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Grid.Column="3" Text="状态" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ListView x:Name="JobsList" Grid.Row="1" ItemsSource="{Binding VisibleJobs}" SelectedItem="{Binding SelectedJob, Mode=TwoWay}" SelectionMode="Single"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="16,10" /></Style></ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate><DataTemplate x:DataType="core:MailJob">
                                        <Grid ColumnSpacing="12" ToolTipService.ToolTip="{Binding Error}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="0.6*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Filename}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Filename}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Email}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Email}" />
                                            <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="邮件预览" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="18" />
                                <StackPanel Grid.Row="1" Spacing="4">
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="收件人" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedJob.Recipient}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SelectedJob.Recipient}" IsTextSelectionEnabled="True" />
                                    </Grid>
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="附件" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedJob.Filename}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SelectedJob.Filename}" IsTextSelectionEnabled="True" />
                                    </Grid>
                                </StackPanel>
                                <!-- 原生阅读视图：有限高度、仅一个纵向 ScrollViewer，不嵌套文本编辑器。 -->
                                <ScrollViewer x:Name="PreviewScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" ZoomMode="Disabled" AutomationProperties.Name="邮件预览正文">
                                    <StackPanel Spacing="12" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding SelectedJob.Subject}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{Binding SelectedJob.Body, TargetNullValue='完成预检后，选择一条记录查看邮件内容。'}" TextWrapping="Wrap" LineHeight="22" IsTextSelectionEnabled="True" />
                                        <InfoBar Severity="Warning" IsClosable="False" IsOpen="{Binding SelectedJob.Error, Converter={StaticResource HasText}}" Message="{Binding SelectedJob.Error}" />
                                    </StackPanel>
                                </ScrollViewer>
                                <Button Grid.Row="3" Content="处理待核实记录…" HorizontalAlignment="Stretch" IsEnabled="{Binding CanResolve}" Visibility="{Binding CanResolve, Converter={StaticResource Visible}}" Click="ResolveUncertain" />
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="5" Spacing="12" Margin="0,16,0,0">
                        <TextBlock Text="{Binding Notice}" Style="{StaticResource MutedTextStyle}" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsChecking}" Maximum="100" />
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button Content="检查文件" Click="CheckFiles" IsEnabled="{Binding CanEdit}" />
                            <Button Grid.Column="1" Content="导出结果" Click="ExportResults" IsEnabled="{Binding CanExport}" />
                            <Button Grid.Column="2" Content="重试失败项" Click="RetryFailed" IsEnabled="{Binding CanRetry}" />
                            <Button Grid.Column="4" Content="停止发送" Click="StopSending" IsEnabled="{Binding CanStop}" />
                            <Button Grid.Column="5" Content="开始发送" Style="{StaticResource AccentButtonStyle}" Click="SendEmails" IsEnabled="{Binding CanSend}" />
                        </Grid>
                    </StackPanel>
                </Grid>
                <Grid x:Name="SettingsPanel" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="6"><TextBlock Text="账户与设置" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="授权码仅保留在本次会话，保存设置不会写入授权码。" Style="{StaticResource MutedTextStyle}" /></StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ContentControl IsEnabled="{Binding CanEdit}" HorizontalContentAlignment="Stretch"><StackPanel x:Name="SettingsForm" Spacing="16" Margin="0,0,16,0" MaxWidth="1000" HorizontalAlignment="Left">
                            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16">
                                <TextBlock Text="发件账户" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="SenderInput" Header="发件邮箱" PlaceholderText="your_email@example.com" TextChanged="SettingsTextChanged" MinWidth="300" />
                                    <PasswordBox x:Name="PasswordInput" Grid.Column="1" Header="邮箱授权码" PasswordRevealMode="Peek" PasswordChanged="SettingsPasswordChanged" MinWidth="300" />
                                </Grid>
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="ServerInput" Header="SMTP 服务器" TextChanged="SettingsTextChanged" />
                                    <NumberBox x:Name="PortInput" Grid.Column="1" Header="端口" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" ValueChanged="SettingsNumberChanged" />
                                    <ComboBox x:Name="SecurityInput" Grid.Column="2" Header="加密方式" HorizontalAlignment="Stretch" SelectionChanged="SettingsSelectionChanged"><ComboBoxItem Content="SSL / TLS · 通常使用 465" /><ComboBoxItem Content="STARTTLS · 通常使用 587" /></ComboBox>
                                </Grid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16">
                                <TextBlock Text="Excel 列映射" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="IdColumnInput" Header="学号列" TextChanged="SettingsTextChanged" /><TextBox x:Name="NameColumnInput" Grid.Column="1" Header="姓名列" TextChanged="SettingsTextChanged" /><TextBox x:Name="EmailColumnInput" Grid.Column="2" Header="邮箱列" TextChanged="SettingsTextChanged" />
                                </Grid>
                                <TextBlock Text="第一行为表头。列支持 A、AA 等字母；含前导零的学号请存为文本。" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16">
                                <TextBlock Text="发送节奏" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="SendIntervalInput" Header="邮件间隔（秒）" Minimum="0" Maximum="86400" SpinButtonPlacementMode="Compact" ValueChanged="SettingsNumberChanged" />
                                    <NumberBox x:Name="RetriesInput" Grid.Column="1" Header="最多尝试次数" Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" ValueChanged="SettingsNumberChanged" />
                                    <NumberBox x:Name="RetryIntervalInput" Grid.Column="2" Header="重试间隔（秒）" Minimum="0" Maximum="86400" SpinButtonPlacementMode="Compact" ValueChanged="SettingsNumberChanged" />
                                </Grid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12">
                                <TextBlock Text="配置与发送日志" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="ConfigLocation" Style="{StaticResource MutedTextStyle}" IsTextSelectionEnabled="True" />
                                <TextBox x:Name="JournalInput" Header="发送日志路径" TextChanged="SettingsTextChanged" ToolTipService.ToolTip="{Binding Text, ElementName=JournalInput}" />
                                <TextBlock Text="同一批任务请始终使用同一份日志。更换日志前，请核对已发送邮件。" Style="{StaticResource MutedTextStyle}" />
                                <Button Content="导入已有配置…" Click="ImportSettings" />
                            </StackPanel></Border>
                        </StackPanel></ContentControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="保存设置" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" IsEnabled="{Binding CanEdit}" Click="SaveSettings" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
